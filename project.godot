[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="ZRot"
run/main_scene="uid://dywuky56e6cv3"
config/features=PackedStringArray("4.6", "Forward Plus")
run/max_fps=60
config/icon="res://icon.svg"

[autoload]

GameManager="*res://Scenes/Scripts/gameManager.gd"
PowerUpManager="*res://power_up_manager.gd"
RoundManager="*res://Scenes/Scripts/round_manager.gd"
SimpleGrass="*res://addons/simplegrasstextured/singleton.tscn"
SaveManager="*res://Scenes/Scripts/save_manager.gd"
DialogueManager="*res://addons/dialogue_manager/dialogue_manager.gd"
